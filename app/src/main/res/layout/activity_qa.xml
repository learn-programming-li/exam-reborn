<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".QaActivity">

    <!-- 背景网格层：GlassUtils 做真实高斯模糊 -->
    <View
        android:id="@+id/bgMesh"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_home" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- 顶栏容器：状态栏高度加在容器上，Toolbar 保持 56dp -->
        <FrameLayout
            android:id="@+id/toolbarBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_toolbar">

            <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                app:menu="@menu/menu_qa"
                app:navigationIcon="@drawable/ic_arrow_back"
                app:navigationIconTint="@color/text_primary"
                app:subtitleTextColor="@color/text_secondary"
                app:title="@string/qa_title"
                app:titleCentered="true"
                app:titleTextColor="@color/text_primary" />
        </FrameLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingTop="20dp"
                android:paddingEnd="20dp"
                android:paddingBottom="20dp">

                <!-- 问题 -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/qa_question_label"
                    android:textColor="@color/brand_indigo"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    app:cardBackgroundColor="@color/glass_card"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/glass_stroke"
                    app:strokeWidth="1dp">

                    <TextView
                        android:id="@+id/tvQuestion"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:lineSpacingExtra="5dp"
                        android:minHeight="120dp"
                        android:padding="18dp"
                        android:textColor="@color/text_primary"
                        android:textSize="16sp"
                        tools:text="导数的定义式" />
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:id="@+id/tvMeta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:visibility="gone"
                    tools:text="第二章 导数与微分 · 难度 3 · 高数,导数" />

                <!-- 我的答案 -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="@string/qa_answer_label"
                    android:textColor="@color/brand_indigo"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <FrameLayout
                    android:id="@+id/answerContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSubmit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:layout_marginTop="16dp"
                    android:text="@string/qa_submit"
                    android:textColor="@color/white"
                    app:backgroundTint="@color/brand_indigo"
                    app:cornerRadius="14dp" />

                <!-- 正确答案 -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:drawableStart="@drawable/ic_check_box"
                    android:drawablePadding="8dp"
                    android:gravity="center_vertical"
                    android:text="@string/qa_correct_label"
                    android:textColor="@color/brand_green"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvCorrect"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_answer"
                    android:lineSpacingExtra="5dp"
                    android:minHeight="120dp"
                    android:padding="18dp"
                    android:text="@string/qa_correct_placeholder"
                    android:textColor="@color/answer_text"
                    android:textSize="16sp" />
            </LinearLayout>
        </ScrollView>

        <!-- 底部毛玻璃操作栏 -->
        <LinearLayout
            android:id="@+id/bottomBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/glass_bar"
            android:elevation="12dp"
            android:orientation="horizontal"
            android:padding="14dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPrev"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/qa_prev"
                android:textColor="@color/brand_indigo"
                app:backgroundTint="@color/white"
                app:cornerRadius="16dp"
                app:strokeColor="@color/input_stroke"
                app:strokeWidth="1dp" />

            <Space
                android:layout_width="10dp"
                android:layout_height="1dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnNote"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/qa_note"
                android:textColor="@color/brand_indigo"
                app:backgroundTint="@color/white"
                app:cornerRadius="16dp"
                app:strokeColor="@color/input_stroke"
                app:strokeWidth="1dp" />

            <Space
                android:layout_width="10dp"
                android:layout_height="1dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnNext"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/qa_next"
                android:textColor="@color/white"
                app:backgroundTint="@color/brand_indigo"
                app:cornerRadius="16dp" />
        </LinearLayout>

    </LinearLayout>
</FrameLayout>
