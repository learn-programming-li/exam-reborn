<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".HomeActivity">

    <!-- 背景网格层：真实高斯模糊，所有玻璃卡的"底" -->
    <View
        android:id="@+id/bgMesh"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_home" />

    <!-- 内容层：ScrollView 的 padding 由 InsetUtils.padAll 注入系统栏高度 -->
    <ScrollView
        android:id="@+id/home"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="12dp"
            android:paddingEnd="20dp"
            android:paddingBottom="32dp">

            <!-- 品牌头：26dp 起始间距 + 状态栏 inset -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="26dp"
                android:letterSpacing="0.08"
                android:text="@string/brand_title"
                android:textColor="@color/brand_terracotta"
                android:textSize="34sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="8dp"
                android:letterSpacing="0.4"
                android:text="@string/brand_subtitle"
                android:textColor="@color/home_subtitle"
                android:textSize="11sp" />

            <!-- 主操作：整块渐变玻璃卡，全页唯一高强调元素 -->
            <LinearLayout
                android:id="@+id/btnStartQa"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                android:background="@drawable/bg_hero"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="20dp"
                android:paddingTop="20dp"
                android:paddingEnd="18dp"
                android:paddingBottom="20dp">

                <ImageView
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_play" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/home_start_qa"
                        android:textColor="@color/white"
                        android:textSize="19sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvStartHint"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:alpha="0.82"
                        android:textColor="@color/white"
                        android:textSize="13sp"
                        tools:text="从「微积分公式」开始练习" />
                </LinearLayout>

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:alpha="0.85"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_arrow_forward" />
            </LinearLayout>

            <!-- 次操作：玻璃描边按钮 -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnViewBanks"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="12dp"
                android:text="@string/home_view_banks"
                android:textColor="@color/brand_indigo"
                android:textSize="16sp"
                app:backgroundTint="@color/glass_card"
                app:cornerRadius="20dp"
                app:icon="@drawable/ic_book"
                app:iconGravity="textStart"
                app:iconPadding="8dp"
                app:iconSize="20dp"
                app:iconTint="@color/brand_indigo"
                app:strokeColor="@color/glass_stroke"
                app:strokeWidth="1dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                android:layout_marginBottom="12dp"
                android:text="@string/home_my_banks"
                android:textColor="@color/text_primary"
                android:textSize="17sp"
                android:textStyle="bold" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvBanks"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never" />

        </LinearLayout>
    </ScrollView>

</FrameLayout>
