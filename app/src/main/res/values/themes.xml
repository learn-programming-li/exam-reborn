<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Base.Theme.EXAMREBORN" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/brand_indigo</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/brand_indigo_deep</item>
        <item name="colorAccent">@color/brand_indigo</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:windowBackground">@color/mesh_base</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.EXAMREBORN.Dialog</item>
    </style>

    <style name="Theme.EXAMREBORN" parent="Base.Theme.EXAMREBORN" />

    <style name="Theme.EXAMREBORN.Splash" parent="Theme.EXAMREBORN">
        <item name="android:windowBackground">@drawable/bg_splash</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="Theme.EXAMREBORN.Home" parent="Theme.EXAMREBORN">
        <item name="android:windowBackground">@color/mesh_base</item>
    </style>

    <style name="ThemeOverlay.EXAMREBORN.Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorPrimary">@color/brand_indigo</item>
        <item name="colorSurface">@color/white</item>
        <item name="colorSurfaceContainerHigh">@color/white</item>
        <item name="colorSurfaceContainerLow">@color/white</item>
        <item name="colorSurfaceContainer">@color/white</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
    </style>

    <style name="Widget.EXAMREBORN.TextField" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxBackgroundColor">@android:color/transparent</item>
        <item name="boxStrokeColor">@color/brand_indigo</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>
        <item name="hintTextColor">@color/brand_indigo</item>
        <item name="android:textColorHint">@color/text_secondary</item>
    </style>

</resources>
